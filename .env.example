# Copy this file to .env. Keep real secrets in .env only; it is git-ignored.

# Hotel workbook and local state
HOTEL_OPS_WORKBOOK=./data/Hotel_Ops_Demo_Data.xlsx
COPILOT_STATE_DB=./data/copilot_state.sqlite3
COPILOT_STATE_KEY=replace_with_a_long_random_secret
COPILOT_API_KEY=replace_with_a_different_long_random_secret
WEB_MANAGER_ID=demo-gm

# Optional OpenAI LLM. Leave the key empty to use the deterministic intent fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional forecast vision: default-off and localhost-only; never enabled on public Streamlit.
FORECAST_AI_PRIVATE_ENABLED=0
FORECAST_AI_ALLOWED_MANAGER_ID=demo-gm
OPENAI_FORECAST_MODEL=gpt-6-luna

# Meta WhatsApp Cloud API placeholders. Fill only after creating/configuring a Meta app.
META_APP_SECRET=
META_GRAPH_API_VERSION=vXX.X
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_webhook_verification_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated manager numbers including country code, e.g. 12125550123
WHATSAPP_ALLOWED_NUMBERS=
# Map an allowlisted WhatsApp number to the same manager id used by the web demo.
# Format: digits=manager_id. Example: 12125550123=demo-gm
WHATSAPP_MANAGER_MAP=

# WhatsApp forecast workflow (development only, fake/no-network by default).
# Legacy allowlist/map above do NOT enroll forecast senders. Use the explicit
# WorkflowStore operator methods described in docs/whatsapp_forecast_workflow.md.
WHATSAPP_FORECAST_ENABLED=0
WHATSAPP_PROVIDER=fake
WHATSAPP_PRODUCTION_APPROVED=0
WHATSAPP_PRIVATE_STORAGE=./data/whatsapp-private
# Inbox additionally requires actual loopback client, explicit WEB_MANAGER_ID,
# and synthetic/demo dataset. Never enable on a public no-sign-in deployment.
WHATSAPP_DEV_INBOX_ENABLED=0

# Optional Twilio adapter. No credentials are supplied; live sending stays off.
# New "Try out WhatsApp" only allows preset ContentSid messages, not this PDF API.
# Account-specific legacy Sandbox/custom-media entitlement needs verification.
TWILIO_WEBHOOK_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Exact external HTTPS URLs, including any query string; never inferred from proxy headers.
TWILIO_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_MEDIA_BASE_URL=
# Local synthetic GET/HEAD capability endpoint only; remote callers always denied.
TWILIO_DEV_MEDIA_ENABLED=0
