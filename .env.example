# Copy this file to .env. Keep real secrets in .env only; it is git-ignored.

# Hotel workbook and local state
HOTEL_OPS_WORKBOOK=./data/Hotel_Ops_Demo_Data.xlsx
COPILOT_STATE_DB=./data/copilot_state.sqlite3
COPILOT_STATE_KEY=replace_with_a_long_random_secret
COPILOT_API_KEY=replace_with_a_different_long_random_secret
WEB_MANAGER_ID=demo-gm

# Optional OpenAI LLM. Leave the key empty to use the deterministic intent fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Meta WhatsApp Cloud API placeholders. Fill only after creating/configuring a Meta app.
META_APP_SECRET=
META_GRAPH_API_VERSION=vXX.X
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_webhook_verification_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated manager numbers including country code, e.g. 12125550123
WHATSAPP_ALLOWED_NUMBERS=
# Map an allowlisted WhatsApp number to the same manager id used by the web demo.
# Format: digits=manager_id. Example: 12125550123=demo-gm
WHATSAPP_MANAGER_MAP=
